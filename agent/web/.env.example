# Скопируйте в .env.local (локально) или задайте в Vercel → Settings → Environment Variables.
# Все переменные — только для сервера: в браузер не уходят.
ANTHROPIC_API_KEY=sk-ant-...
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # или старый anon key
SUPABASE_SECRET_KEY=sb_secret_...             # или старый service_role key — никому не показывать
