# Для автотестов: локальный Supabase (npx supabase start). Скопируйте в .env.e2e.
# Ключи — из вывода `npx supabase status` (Publishable / Secret или anon / service_role).
ANTHROPIC_API_KEY=sk-ant-...           # нужен только для платного e2e:crisis
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
